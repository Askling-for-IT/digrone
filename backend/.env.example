# The frontend uses port 8080; the Go API uses 8083; local Keycloak uses 8081.
PORT=8083
VERSION=0.0.1
# Local development only. Use your server credentials and TLS policy in production.
DATABASE_URL=postgres://digrone:digrone@localhost:5435/digrone?sslmode=disable

# External frontend origin (no trailing slash). HTTPS enables Secure cookies.
APP_URL=http://localhost:8080
# Your existing Keycloak realm URL and confidential client credentials.
OIDC_ISSUER=https://auth.example.com/realms/digrone
OIDC_CLIENT_ID=digrone
OIDC_CLIENT_SECRET=replace-with-keycloak-client-secret
# Defaults to APP_URL + /auth/callback.
OIDC_REDIRECT_URL=http://localhost:8080/auth/callback
OIDC_ADMIN_ROLE=admin
