APP_PUBLIC_URL=https://xn--digrne-zxa.se

# Existing shared Docker network and PostgreSQL service. No new DB server.
SHARED_NETWORK=twogo_default
# URL-encode special characters in the database password.
DATABASE_URL=postgres://digrone:replace-with-url-encoded-password@postgres:5432/digrone?sslmode=disable

# Public issuer must match Keycloak's discovery document and token issuer.
KEYCLOAK_PUBLIC_URL=https://twogo.se/keycloak
KEYCLOAK_REALM=digrone
OIDC_CLIENT_ID=digrone
OIDC_CLIENT_SECRET=replace-with-digrone-client-secret
